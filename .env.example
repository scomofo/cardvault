# Leave blank on first launch, then add a real key in CardVault Settings.
ANTHROPIC_API_KEY=
# Optional for API-only deployments. When set, every /api route requires
# Authorization: Bearer <token>; leave blank when using the built-in UI.
PROXY_TOKEN=
# Bind the dev servers to the MacBook so an iPhone on the same Wi-Fi can connect.
HOST=0.0.0.0
# Express proxies CV requests to the local Python service.
CV_SERVICE_URL=http://127.0.0.1:8000
# Vite proxy targets; override only if the API or CV service runs elsewhere.
CARDVAULT_API_URL=http://127.0.0.1:3001
CARDVAULT_CV_URL=http://127.0.0.1:8000
# Optional trusted HTTPS certs for iPhone Safari live camera access.
# Create these with mkcert on the MacBook and point them at your generated files.
SSL_KEY_FILE=certs/cardvault-key.pem
SSL_CERT_FILE=certs/cardvault-cert.pem
# Optional CA bundle if your setup exports one.
SSL_CA_FILE=
# Prefer a hostname covered by the cert, such as your Mac's Bonjour name.
DEV_HOSTNAME=cardvault.local
# eBay OAuth uses your app's RuName as redirect_uri, not the callback URL.
EBAY_RU_NAME=
# Configure this same callback URL in the eBay developer portal for your RuName.
EBAY_CALLBACK_URL=http://localhost:3000/api/ebay/callback
